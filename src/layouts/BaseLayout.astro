---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import 'aos/dist/aos.css';
import '../styles/global.css';
// Fonte do texto principal (subconjunto latino), pré-carregada no <head> para não
// esperar o CSS ser lido antes de começar o download.
import fonteInter from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { navegacao, site } from '../data/site';

interface Props {
  /** Título da página; o sufixo do site é aplicado automaticamente. */
  titulo?: string;
  descricao?: string;
  imagem?: string;
  imagemAlt?: string;
  tipoOg?: 'website' | 'article' | 'video.other' | 'music.song';
  jsonLd?: Record<string, unknown>[];
  semIndexacao?: boolean;
  /** Seção ativa da navegação (aria-current). */
  ativo?: string;
}

const {
  titulo,
  descricao = site.descricao,
  imagem = '/og.png',
  imagemAlt = `${site.nome}, portfólio acadêmico de ${site.autor}`,
  tipoOg = 'website',
  jsonLd = [],
  semIndexacao = false,
  ativo,
} = Astro.props;

const tituloCompleto = titulo
  ? `${titulo} | ${site.nome} · ${site.autor}`
  : `${site.nome} · Portfólio acadêmico de ${site.autor}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagemAbsoluta = new URL(imagem, Astro.site);
---

<!doctype html>
<html lang={site.idioma}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <meta name="author" content={site.autor} />
    <meta name="robots" content={semIndexacao ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f5f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#08080a" media="(prefers-color-scheme: dark)" />

    <link rel="preload" href={fonteInter} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={tipoOg} />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={imagemAbsoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imagemAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={imagemAbsoluta} />
    <meta name="twitter:image:alt" content={imagemAlt} />

    {jsonLd.map((dados) => <script type="application/ld+json" set:html={JSON.stringify(dados)} />)}

    <!--
      Tema antes da primeira pintura (preferência salva > sistema) e de novo a
      cada troca de página do ClientRouter, para não piscar o tema errado.
    -->
    <script is:inline>
      (() => {
        const aplicar = () => {
          let salvo = null;
          try {
            salvo = localStorage.getItem('theme');
          } catch {}
          const escuro = salvo ? salvo === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', escuro);
        };
        aplicar();
        document.addEventListener('astro:after-swap', aplicar);
      })();
    </script>

    <!-- Navegação suave entre páginas (respeita prefers-reduced-motion). -->
    <ClientRouter />
    <noscript>
      <style>
        [data-aos] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-accent focus:text-on-accent focus:px-5 focus:py-3 focus:rounded-xl font-semibold"
    >
      Pular para o conteúdo
    </a>

    <Header links={navegacao} ativo={ativo} destaque="/trabalhos/video-institucional-ia/" />

    <main id="conteudo" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>

    <Footer />

    <script>
      import AOS from 'aos';

      const opcoesAos = { duration: 900, easing: 'ease-out-cubic', delay: 0 } as const;

      AOS.init({
        ...opcoesAos,
        offset: 40,
        once: true,
        // A troca de página é tratada abaixo, no astro:after-swap. O observador de DOM do
        // AOS reagiria à troca do <body> antes disso e na ordem errada.
        disableMutationObserver: true,
        disable: () => window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      });

      // Com o ClientRouter, a página nova chega sem recarregar e com um <body> novo.
      document.addEventListener('astro:after-swap', () => {
        // 1) O que já está na tela entra junto com o crossfade do ClientRouter. Animá-lo de
        //    novo faria a página chegar vazia e o conteúdo subir só depois (~1 s de espera).
        //    A rolagem já foi restaurada aqui. Isso vem antes de reaplicar a duração, para
        //    que tirar o atributo não dispare uma transição.
        const alturaTela = window.innerHeight;
        document.querySelectorAll<HTMLElement>('[data-aos]').forEach((el) => {
          const caixa = el.getBoundingClientRect();
          if (caixa.top < alturaTela && caixa.bottom > 0) el.removeAttribute('data-aos');
        });

        // 2) O AOS guarda duração e easing em atributos do body (o CSS lê de lá); sem eles
        //    a transição vira 0s e o que está abaixo da dobra "brota" ao rolar.
        document.body.setAttribute('data-aos-duration', String(opcoesAos.duration));
        document.body.setAttribute('data-aos-easing', opcoesAos.easing);
        document.body.setAttribute('data-aos-delay', String(opcoesAos.delay));

        AOS.refreshHard();
      });

      // Pausa as animações decorativas ([data-ambiente]) enquanto estão fora da tela.
      document.addEventListener('astro:page-load', () => {
        const blocos = document.querySelectorAll<HTMLElement>('[data-ambiente]');
        if (!blocos.length) return;
        const observador = new IntersectionObserver(
          (entradas) => entradas.forEach((e) => e.target.classList.toggle('fora-da-tela', !e.isIntersecting)),
          { rootMargin: '100px 0px' },
        );
        blocos.forEach((bloco) => observador.observe(bloco));
        document.addEventListener('astro:before-swap', () => observador.disconnect(), { once: true });
      });

      // O roteador não decodifica âncoras com acento (ex.: #edição-no-audacity); rola até elas aqui.
      document.addEventListener('astro:page-load', () => {
        if (!location.hash) return;
        const alvo = document.getElementById(decodeURIComponent(location.hash.slice(1)));
        alvo?.scrollIntoView({ block: 'start', behavior: 'instant' });
      });

      // Brilho que acompanha o cursor nos cards marcados com [data-glow].
      const podeBrilhar =
        matchMedia('(hover: hover) and (pointer: fine)').matches &&
        !matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (podeBrilhar) {
        document.addEventListener(
          'pointermove',
          (evento) => {
            const alvo = (evento.target as Element | null)?.closest<HTMLElement>('[data-glow]');
            if (!alvo) return;
            const caixa = alvo.getBoundingClientRect();
            alvo.style.setProperty('--mx', `${evento.clientX - caixa.left}px`);
            alvo.style.setProperty('--my', `${evento.clientY - caixa.top}px`);
          },
          { passive: true },
        );
      }

      // Sem preferência salva, acompanha mudanças do tema do sistema em tempo real.
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (evento) => {
        let salvo = null;
        try {
          salvo = localStorage.getItem('theme');
        } catch {}
        if (!salvo) document.documentElement.classList.toggle('dark', evento.matches);
      });
    </script>
  </body>
</html>
