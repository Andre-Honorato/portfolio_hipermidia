---
import { ArrowLeft } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import Art from '../components/Art.astro';
---

<BaseLayout titulo="Página não encontrada" descricao="O endereço acessado não existe neste portfólio." semIndexacao>
  <section class="frame pt-6 sm:pt-10">
    <div class="relative overflow-hidden rounded-[var(--radius-panel)] bg-[#0b0b10] text-white min-h-[60vh] grid place-items-center text-center px-6 py-20">
      <div class="absolute inset-0" aria-hidden="true"><Art tom="grafite" arte="prisma" /></div>
      <div class="relative flex flex-col items-center gap-5">
        <span class="chip glass tabular-nums">Erro 404</span>
        <h1 class="t-hero max-w-[16ch]">Essa cena ficou fora do corte</h1>
        <p class="text-white/75 text-lg max-w-[30rem]">A página não existe ou mudou de endereço. Volte ao início para ver todos os trabalhos.</p>
        <a href="/" class="group btn btn-primary btn-lg mt-2">
          <ArrowLeft className="w-4 h-4 transition-transform duration-300 group-hover:-translate-x-1" strokeWidth={1.75} aria-hidden="true" />
          Ir para o início
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
