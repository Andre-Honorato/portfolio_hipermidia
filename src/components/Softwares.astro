---
import { ArrowUpRight, Check, Monitor, Scale } from 'lucide-react';
import Eyebrow from './Eyebrow.astro';
import SoftwareMock from './SoftwareMock.astro';
import { softwares } from '../data/site';
import { listarTrabalhos, numeroFormatado, rotuloTipo, urlTrabalho } from '../lib/trabalhos';

/**
 * "Programas usados nos trabalhos": os dois softwares da disciplina, com logo oficial,
 * o que é, para que serve e em quais trabalhos foi usado.
 */
interface Props {
  cena: number;
}

const { cena } = Astro.props;
const trabalhos = await listarTrabalhos();
const usadoEm = (nome: string) =>
  trabalhos.filter((t) => t.data.ferramentas.some((f) => f.toLowerCase() === nome.toLowerCase()));
---

<section id="ferramentas" aria-labelledby="titulo-ferramentas" class="frame section !pt-0">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="max-w-[38rem]" data-aos="fade-up">
      <Eyebrow cena={cena} rotulo="Ferramentas" />
      <h2 id="titulo-ferramentas" class="t-h2 mt-3">Programas usados nos trabalhos</h2>
      <p class="t-lead mt-4">
        Os dois programas da disciplina: o DaVinci Resolve, usado nos vídeos, e o Audacity, usado no áudio.
      </p>
    </div>
  </div>

  <ul class="grid grid-cols-1 gap-5 lg:grid-cols-2 mt-10 sm:mt-12" role="list">
    {
      softwares.map((sw, i) => {
        const trabalhosSw = usadoEm(sw.nome);
        return (
          <li data-aos="fade-up" data-aos-delay={i * 100}>
            <article class="card h-full flex flex-col overflow-hidden" aria-labelledby={`sw-${sw.slug}`}>
              <div class="h-44 sm:h-48 m-2 mb-0 rounded-[calc(var(--radius-card)-0.375rem)] overflow-hidden ring-1 ring-hairline">
                <SoftwareMock slug={sw.slug} />
              </div>

              <div class="flex flex-col gap-6 p-6 sm:p-7 flex-1">
                <header class="flex items-center gap-4">
                  <img
                    src={sw.logo}
                    alt={`Logo do ${sw.nome}`}
                    width="56"
                    height="56"
                    loading="lazy"
                    decoding="async"
                    class="w-14 h-14 shrink-0 drop-shadow-[0_6px_14px_rgb(0_0_0/0.25)]"
                  />
                  <div class="min-w-0">
                    <h3 id={`sw-${sw.slug}`} class="font-semibold text-2xl tracking-[-0.025em]">{sw.nome}</h3>
                    <p class="text-sm text-ink-soft">{sw.fabricante}</p>
                  </div>
                </header>

                <div>
                  <h4 class="text-xs font-semibold uppercase tracking-wider text-accent-text">O que é</h4>
                  <p class="mt-2 text-ink-soft leading-relaxed">{sw.oQueE}</p>
                </div>

                <div>
                  <h4 class="text-xs font-semibold uppercase tracking-wider text-accent-text">Para que serve</h4>
                  <ul class="mt-3 grid gap-2.5">
                    {sw.usos.map((uso) => (
                      <li class="flex items-start gap-3">
                        <span class="grid place-items-center w-5 h-5 rounded-full bg-accent-soft text-accent-text shrink-0 mt-0.5">
                          <Check className="w-3 h-3" strokeWidth={3} aria-hidden="true" />
                        </span>
                        <span class="leading-snug">{uso}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="tile p-4">
                  <h4 class="text-xs font-semibold uppercase tracking-wider text-ink-soft">Na disciplina</h4>
                  <p class="mt-1.5 text-sm leading-relaxed">{sw.naDisciplina}</p>
                  {trabalhosSw.length > 0 && (
                    <ul class="mt-3 flex flex-wrap gap-1.5" aria-label={`Trabalhos feitos com ${sw.nome}`}>
                      {trabalhosSw.map((t) => (
                        <li>
                          <a
                            href={urlTrabalho(t)}
                            class="group chip bg-surface border border-hairline hover:border-hairline-strong transition-colors"
                          >
                            <span class="font-mono text-xs text-accent-text">{numeroFormatado(t.data.numero)}</span>
                            {rotuloTipo[t.data.tipo]}
                            <ArrowUpRight className="arrow-go w-3.5 h-3.5 text-ink-soft" strokeWidth={2} aria-hidden="true" />
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>

                <footer class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-2 text-sm">
                  <div class="flex flex-wrap gap-x-4 gap-y-1 text-ink-soft">
                    <span class="inline-flex items-center gap-1.5">
                      <Scale className="w-4 h-4" strokeWidth={1.75} aria-hidden="true" />
                      {sw.licenca}
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                      <Monitor className="w-4 h-4" strokeWidth={1.75} aria-hidden="true" />
                      {sw.plataformas}
                    </span>
                  </div>
                  <a
                    href={sw.site}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-center gap-1 min-h-11 font-semibold text-accent-text"
                  >
                    Site oficial
                    <span class="sr-only">do {sw.nome} (abre em nova aba)</span>
                    <ArrowUpRight className="arrow-go w-4 h-4" strokeWidth={2} aria-hidden="true" />
                  </a>
                </footer>
              </div>
            </article>
          </li>
        );
      })
    }
  </ul>
</section>
