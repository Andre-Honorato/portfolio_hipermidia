---
import { paletaTom, type Trabalho } from '../lib/trabalhos';

/**
 * Arte de capa abstrata (SVG): luzes desfocadas na paleta do trabalho,
 * uma composição gráfica fina e granulado de filme. Sempre escura, como um
 * pôster, nos dois temas. Use `midia.poster` quando houver imagem real.
 */
interface Props {
  tom: Trabalho['data']['tom'];
  arte: Trabalho['data']['arte'];
  classe?: string;
  /** Liga a deriva lenta das luzes. */
  viva?: boolean;
}

const { tom, arte, classe = '', viva = true } = Astro.props;
const [a, b, c] = paletaTom[tom];
const uid = `a${Math.random().toString(36).slice(2, 8)}`;
const deriva = (dur: number, atraso: number, dx: number, dy: number) =>
  viva ? `--drift-dur:${dur}s;--drift-delay:${atraso}s;--dx:${dx}px;--dy:${dy}px;transform-box:fill-box;transform-origin:center` : '';

// Ondas da composição "onda": [amplitude, frequência, fase, opacidade]
const ondas: [number, number, number, number][] = [
  [70, 2.2, 0, 0.9],
  [48, 3.1, 1.2, 0.55],
  [28, 4.4, 2.4, 0.35],
];
const caminhoOnda = (amp: number, freq: number, fase: number) =>
  Array.from({ length: 81 }, (_, i) => {
    const x = (i / 80) * 800;
    const envelope = Math.sin((i / 80) * Math.PI);
    const y = 300 + Math.sin((i / 80) * Math.PI * 2 * freq + fase) * amp * envelope;
    return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`;
  }).join(' ');
---

<svg
  data-ambiente
  viewBox="0 0 800 600"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
  class:list={['w-full h-full', classe]}
>
  <defs>
    <filter id={`${uid}-blur`} x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="70" />
    </filter>
    <filter id={`${uid}-grao`}>
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch" />
      <feColorMatrix type="saturate" values="0" />
    </filter>
    <linearGradient id={`${uid}-linha`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0" />
      <stop offset="0.5" stop-color="#fff" stop-opacity="0.85" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <radialGradient id={`${uid}-vinheta`} cx="0.5" cy="0.5" r="0.75">
      <stop offset="0.55" stop-color="#000" stop-opacity="0" />
      <stop offset="1" stop-color="#000" stop-opacity="0.65" />
    </radialGradient>
  </defs>

  <rect width="800" height="600" fill="#0b0b10" />

  <g filter={`url(#${uid}-blur)`} opacity="0.95">
    <circle cx="250" cy="220" r="190" fill={a} class={viva ? 'drift' : ''} style={deriva(20, 0, 60, 40)} />
    <circle cx="560" cy="380" r="200" fill={b} class={viva ? 'drift' : ''} style={deriva(24, -6, -70, -30)} />
    <circle cx="520" cy="140" r="130" fill={c} class={viva ? 'drift' : ''} style={deriva(18, -10, -40, 50)} />
  </g>

  {
    arte === 'aurora' && (
      <g fill="none" stroke-linecap="round">
        <path d="M-40 430 C 200 300, 520 520, 860 330" stroke={`url(#${uid}-linha)`} stroke-width="1.5" opacity="0.7" />
        <path d="M-40 470 C 220 360, 540 560, 860 380" stroke={`url(#${uid}-linha)`} stroke-width="1" opacity="0.45" />
        <path d="M-40 390 C 180 250, 500 470, 860 280" stroke={`url(#${uid}-linha)`} stroke-width="1" opacity="0.3" />
      </g>
    )
  }

  {
    arte === 'prisma' && (
      <g fill="none" stroke="#fff" stroke-width="1">
        <rect x="250" y="150" width="300" height="300" rx="40" opacity="0.55" transform="rotate(12 400 300)" />
        <rect x="285" y="185" width="230" height="230" rx="30" opacity="0.35" transform="rotate(24 400 300)" />
        <rect x="320" y="220" width="160" height="160" rx="20" opacity="0.2" transform="rotate(36 400 300)" />
        <line x1="0" y1="300" x2="800" y2="300" stroke={`url(#${uid}-linha)`} opacity="0.35" />
      </g>
    )
  }

  {
    arte === 'onda' && (
      <g fill="none" stroke-linecap="round">
        {ondas.map(([amp, freq, fase, op]) => (
          <path d={caminhoOnda(amp, freq, fase)} stroke="#fff" stroke-width="1.5" opacity={op} />
        ))}
        <line x1="40" y1="300" x2="760" y2="300" stroke="#fff" stroke-width="0.75" opacity="0.18" />
      </g>
    )
  }

  <rect width="800" height="600" fill={`url(#${uid}-vinheta)`} />
  <rect width="800" height="600" filter={`url(#${uid}-grao)`} opacity="0.13" style="mix-blend-mode: overlay" />
</svg>
